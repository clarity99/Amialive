# --- Who / when ---------------------------------------------------------------
AMIALIVE_NAME=Rob               # how you appear in messages to your contacts
TZ=Europe/London
CHECKIN_TIME=09:00              # daily prompt time (HH:MM, in TZ)
GRACE_PERIOD=4h                 # time allowed to answer before it counts as missed
MISSED_CHECKINS=1               # consecutive missed check-ins before contacts are alerted
REMINDER_INTERVAL=1h            # re-ping while unanswered (0 = off)

# --- Primary check-in channel: Telegram ----------------------------------------
# Create a bot with @BotFather, then message it /start to learn your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Alerts by email (SMTP; 587=STARTTLS, 465=TLS) -----------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=amialive@example.com

# --- Alerts by SMS (Twilio) -----------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550000000

# --- Optional: email check-in fallback (needs HTTPS reverse proxy to :8080) ----
USER_EMAIL=
BASE_URL=
CHECKIN_SECRET=                 # >=16 random chars: openssl rand -hex 24

# --- Optional: dead-man's switch so you learn if Amialive itself dies ----------
HEARTBEAT_URL=                  # e.g. https://hc-ping.com/<uuid>
